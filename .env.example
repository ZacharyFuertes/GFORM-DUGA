# Google Form Automation Configuration
# Optional environment variables

# Path to config file (relative or absolute)
# FORM_CONFIG=config.json

# Maximum retries per submission
# MAX_RETRIES=3

# Request timeout in seconds
# TIMEOUT=10

# Minimum delay between submissions (seconds)
# MIN_DELAY=2

# Maximum delay between submissions (seconds)
# MAX_DELAY=5

# Enable verbose logging
# VERBOSE=false
